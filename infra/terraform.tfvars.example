# Copy to <instance>.tfvars (ignored by git), add backends/<instance>.s3.tfbackend,
# then: AWS_PROFILE=<profile> ./tf.sh <instance> plan

name_prefix = "gp-acme"
owner_email = "you@example.com"
region      = "eu-central-1"

# Custom domain with the parent zone in this account:
domain_name    = "gp.example.com"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Existing Cognito pool (leave out to create one):
# cognito_user_pool_id = "eu-central-1_XXXXXXXXX"

guide_language = "uk"

# Password rules (defaults: at least 8 characters, no required character types).
# With an existing user pool, set these to match the pool: they are only shown to people.
# password_policy = {
#   minimum_length    = 12
#   require_lowercase = true
#   require_uppercase = true
#   require_numbers   = true
#   require_symbols   = false
# }
