{
  "name": "guidepass",
  "private": true,
  "version": "0.3.0",
  "description": "Manual testing guides written by AI agents, run by people on their devices, read back through MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vStesh/guidepass.git"
  },
  "homepage": "https://github.com/vStesh/guidepass#readme",
  "bugs": {
    "url": "https://github.com/vStesh/guidepass/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint .",
    "build": "npm run build -w api && npm run build -w web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "oxlint": "^1.86.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
