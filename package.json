{
  "name": "guidepass",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint .",
    "build": "npm run build -w api && npm run build -w web"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
